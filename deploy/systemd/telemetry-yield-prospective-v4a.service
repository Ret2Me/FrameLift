[Unit]
Description=Telemetry Yield prospective SatNOGS shadow planner v4a
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=21600
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/telemetry-yield
ExecStart=/bin/bash /home/ubuntu/telemetry-yield/scripts/prospective-v4a-daily.sh
Restart=on-failure
RestartSec=900
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
